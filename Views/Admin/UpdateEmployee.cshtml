@model ELMS.Models.UpdateEmployeeViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div class="container mt-4" style="max-width: 600px">

    <h4 class="text-center mb-4">Update Employee</h4>

    <form asp-controller="Admin" asp-action="updateEmployee" method="post">
        <input type="hidden" asp-for="fiEmployeeId" />
        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="stFirstName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="stLastName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="stEmailAddress" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input asp-for="stPhone" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Department</label>
            <input asp-for="stDepartment" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <select asp-for="stRole" class="form-select">
                <option value="Employee">Employee</option>
                <option value="Manager">Manager</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Manager</label>
            <select asp-for="inManagerId" class="form-select">
                <option value="">--Select Manager--</option>
                @foreach (var m in Model.lsManagers)
                {
                    <option value="@m.inEmployeeId">
                        @m.stFirstName @m.stLastName
                    </option>
                }
            </select>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary px-4">Update</button>
        </div>

    </form>

</div>