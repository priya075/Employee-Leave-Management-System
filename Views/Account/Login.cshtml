<div class="container vh-100 vw-100 d-flex justify-content-center align-items-center" >
    <div class="w-100" style="max-width:500px">
        
        <h3 class="text-center mb-4">Please Login!</h3>
        
        <form method="post" asp-action="login" class="p-5 border shadow-sm ">
            
            <div class="mb-2">
                <label class="form-label">Enter your Email</label>
                <input type="email" name="fsEmail" class="form-control" required />
