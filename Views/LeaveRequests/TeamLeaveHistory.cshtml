@model IEnumerable<ELMS.Models.tblLeaveRequests>

@using ELMS.Services

@inject UserContext moUser

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@if (!Model.Any())
{
    <p>No team leaves found</p>
}
else
{
    <table class="table table-bordered table-striped text-center">
        <thead>
            <th>Employee Id</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Comment</th>
            <th style="width: 220px">Action</th>            
        </thead>

        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>@l.itEmployeeId</td>
                    <td>@l.dtStartDate.ToString("dd-MM-yyyy")</td>
                    <td>@l.dtEndDate.ToString("dd-MM-yyyy")</td>
                    <td>@l.stReason</td>
                    <td>@l.stStatus</td>
                    <td>@l.stManagerComment</td>
                    <td>
                        @if(l.stStatus == "Pending")
                        {
                            <form asp-controller="LeaveRequests" method="post" style="display:inline">
                                <input type="hidden" name="fiLeaveRequestId" value="@l.itLeaveRequestId" />
                                <input type="text" name="fsManagerComment" value="@l.stManagerComment" class="form-control form-control-sm mb-2" style="width: 180px"/>
                                <button formaction="/LeaveRequests/approve" type="submit" class="btn btn-success btn-sm">Approve</button>
                                <button formaction="/LeaveRequests/reject" type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                        }
                    </td>
                    
                </tr>
            }
        </tbody>
    </table>
}