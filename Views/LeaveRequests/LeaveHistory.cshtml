@model IEnumerable<ELMS.Models.tblLeaveRequests>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="container mt-4">
    <h3> All Leaves </h3>
    <br />
    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center">
            <thead>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Applied Date</th>
                <th>Decision Date</th>
                <th>Actions</th>
            </thead>

            <tbody>
                @foreach(var l in Model)
                {
                    <tr>
                        <td>@l.dtStartDate.ToString("dd-MM-yyyy")</td>
                        <td>@l.dtEndDate.ToString("dd-MM-yyyy")</td>
                        <td>@l.stReason</td>
                        <td>
                            @if (@l.stStatus == "Pending")
                            {
                                <span class="badge bg-warning">
                                    Pending 
                                </span>
                            }
                            else if (@l.stStatus == "Approved")
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (@l.stStatus == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else if (@l.stStatus == "Cancelled")
                            {
                                <span class="badge bg-secondary">
                                    Rejected
                                </span>
                            }
                        </td>
                        <td>@l.dtAppliedDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            @if(@l.stStatus == "Pending")
                            {
                                <span>-</span>
                            }
                            else
                            {
                                @l.dtDecisionDate.ToString()
                            }
                        </td>
                        <td>
                            @if(l.stStatus == "Pending")
                            {
                                <form method="post" asp-action="cancel">
                                    <input type="hidden" name="fiLeaveRequestId" value="@l.itLeaveRequestId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>    
                }
            </tbody>
        </table>
    </div>
</div>


